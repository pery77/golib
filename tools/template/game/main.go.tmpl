// {{name}} is a game made with GoLib. DESIGN.md says what it is.
//
// Read it in this order:
//
//   - main.go (this file) starts the game: main calls golib.Run with the first
//     scene. The screen's size and the game's colors are here.
//   - play.go is the scene where the game is played: Update turns the keyboard
//     and gamepad into actions for the world, and Draw draws the world.
//   - world.go holds the rules as plain Go, with no input or drawing, so that
//     world_test.go can test them.
//   - game.json names the game in the executables golib builds on Windows:
//     its title, version and author.
//
// games/platformer is a complete example, with a title, pause and win scenes,
// and a world larger than the screen, seen through a golib.Camera.
package main

import (
	"log"

	"golib"
)

// The screen's size in pixels. It never changes: GoLib scales it to the
// window. The world can be larger (see world.go).
const (
	screenWidth  = 1280
	screenHeight = 720
)

// The game's colors, in one place so the look is easy to change.
var (
	backgroundColor = golib.RayWhite
	playerColor     = golib.Maroon
	textColor       = golib.DarkGray
)

func main() {
	config := golib.Config{
		Title: "{{name}}", Width: screenWidth, Height: screenHeight,
		// The game waits while the player is in another program. Take it out
		// for a game that should keep playing in the background.
		PauseUnfocused: true,
	}
	if err := golib.Run(newPlayScene(), config); err != nil {
		log.Fatal(err)
	}
}
