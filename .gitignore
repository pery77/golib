# Local toolchains downloaded by "golib setup". Safe to delete; setup recreates them.
/.tools/

# Build outputs
/build/
*.exe
*.test
*.out
__debug_bin*

# Your games: nothing in games/ enters this repository but its README, so each
# game can have a git repository of its own. GoLib's examples live in
# examples/. See docs/architecture.md#your-games.
/games/*
!/games/README.md

# Personal Claude Code settings
.claude/settings.local.json

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# golib build and dist put Windows resources next to a game's main.go while they build.
golib_windows_*.syso
