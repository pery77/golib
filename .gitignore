# Local toolchains downloaded by "golib setup". Safe to delete; setup recreates them.
/.tools/

# Build outputs
/build/
*.exe
*.test
*.out
__debug_bin*

# Private games: a game folder whose name starts with "_" never enters this
# repository, so it can be kept elsewhere, in a git repository of its own.
# See docs/architecture.md#private-games.
/games/_*/

# Personal Claude Code settings
.claude/settings.local.json

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# golib build and dist put Windows resources next to a game's main.go while they build.
golib_windows_*.syso
